# ============================================================
# GiaSư AI — Backend Environment Variables
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# ============================================================
# AI / Hugging Face
# ============================================================
# Token Hugging Face — lấy tại https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here

# Model chat (OpenAI-compatible endpoint)
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_ROUTER_URL=https://router.huggingface.co/v1/chat/completions

# Model TTS (Kokoro)
HF_TTS_MODEL=hexgrad/Kokoro-82M

# ============================================================
# TTS Provider
#   edge  — msedge-tts (khuyên dùng, nhanh + chất lượng cao)
#   hf    — Kokoro qua Hugging Face Inference API
# ============================================================
TTS_PROVIDER=edge

# ============================================================
# Demo mode
#   true  — dùng lời giải mẫu, không cần API key
#   false — dùng AI thật
# ============================================================
DEMO_MODE=false

# ============================================================
# Database (MongoDB Atlas)
# ============================================================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/giasuai?retryWrites=true&w=majority

# ============================================================
# JWT
# ============================================================
JWT_SECRET=your_super_secret_random_string_here

# ============================================================
# Google OAuth (tùy chọn)
#   1. Tạo project tại https://console.cloud.google.com
#   2. Credentials → OAuth 2.0 Client IDs → Web application
#   3. Thêm Authorized redirect URI: https://your-domain.com/api/auth/google/callback
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ============================================================
# Frontend URL (CORS — chỉ dùng trong môi trường dev riêng biệt)
#   Production: frontend cùng domain với backend → không cần set
# ============================================================
FRONTEND_URL=http://localhost:5173
